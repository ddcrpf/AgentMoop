# Copy to .env. Never commit .env.
# Active values are for local development (npm run dev). Clerk development keys go in clerk_env.env.
PUBLIC_BASE_URL=http://127.0.0.1:3434
HOST=127.0.0.1
PORT=3434
DATA_DIR=.data
TRUST_PROXY_HOPS=0
ALLOW_HTTP_LOOPBACK=true

# Production / self-hosting (docker compose): comment out the local block above and use these instead.
# PUBLIC_BASE_URL=https://ping.example.com
# CLERK_PUBLISHABLE_KEY=pk_live_xxx
# CLERK_SECRET_KEY=sk_live_xxx
# Number of reverse proxies between clients and the app (Caddy alone = 1).
# TRUST_PROXY_HOPS=1
